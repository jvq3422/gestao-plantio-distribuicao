rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidClientWrite() {
      let syncControl = /databases/$(database)/documents/recreio_meta/sync_control;
      let lastReset = exists(syncControl) ? get(syncControl).data.lastResetAt : 0;
      let now = request.time.toMillis();
      let ct = request.resource.data.clientTimestamp;
      return request.resource.data.syncVersion == 5
        && ct is int
        && ct > lastReset
        && ct <= now + 60000
        && (now - ct) < 60000;
    }

    match /recreio_plots/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_analyses/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_harvests/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_produtos/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_pdvs/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_precos/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_saidas/{id} {
      allow read, delete: if true;
      allow create, update: if isValidClientWrite();
    }
    match /recreio_meta/{id} {
      allow read, write: if true;
    }
  }
}
