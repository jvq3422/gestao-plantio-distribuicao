rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recreio_plots/{plotId} {
      allow create, update: if plotId != 'plot-1791480431576' && plotId != 'plot-1791479242881';
      allow delete: if true;
      allow read: if true;
    }
    match /recreio_analyses/{id} {
      allow read, write: if true;
    }
    match /recreio_harvests/{id} {
      allow read, write: if true;
    }
    match /recreio_produtos/{id} {
      allow read, write: if true;
    }
    match /recreio_pdvs/{id} {
      allow read, write: if true;
    }
    match /recreio_precos/{id} {
      allow read, write: if true;
    }
    match /recreio_saidas/{id} {
      allow read, write: if true;
    }
    match /recreio_meta/{id} {
      allow read, write: if true;
    }
  }
}
